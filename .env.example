# Copia este archivo a .env y rellena valores reales. .env nunca se sube a git.

# Usada tanto por `python main.py` directo como por el servicio "app" de
# docker-compose.yml (ahí sí es obligatoria, no tiene fallback de archivo).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Credenciales de la base de datos PostgreSQL (usadas tanto por docker-compose.yml
# como por Flask a través de SQLALCHEMY_DATABASE_URI, deben coincidir).
POSTGRES_USER=suiteencript
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-fuerte
POSTGRES_DB=suiteencript

# Puerto 5433 (no el 5432 por defecto) para no chocar con otro Postgres que
# pueda estar corriendo en la misma máquina — ver docker-compose.yml.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://suiteencript:cambia-esto-por-una-contrasena-fuerte@localhost:5433/suiteencript

# Poner en "true" solo detrás de HTTPS real (producción).
FORCE_HTTPS=false

# Clave maestra AES-256 de la bóveda, en base64. Obligatoria si FORCE_HTTPS=true
# (producción) o para el servicio "app" de docker-compose.yml (usa un volumen
# para uploads/ pero no para esta clave — más simple usar la misma variable de
# entorno que ya se necesita en producción). Si se omite y FORCE_HTTPS=false,
# se autogenera un archivo vault_master.key en la raíz por comodidad (solo
# aplica a `python main.py` directo, no al contenedor). Generar con:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#VAULT_MASTER_KEY=

# Backend de almacenamiento para Flask-Limiter (rate limiting). Si se omite,
# usa memoria del proceso — solo válido con un único worker. docker-compose.yml
# ya fija esto a redis://redis:6379/0 para el servicio "app". Fuera de
# Docker, solo hace falta si corrés con varios workers.
#RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Almacenamiento S3-compatible para los archivos de la bóveda.
# Deben estar las 5 juntas o ninguna: si falta una, se ignoran todas y se
# usa disco local (app/uploads/, o el volumen de docker-compose.yml) — el
# mismo criterio de "todo o el fallback completo" que VAULT_MASTER_KEY.
# Necesarias en producción (Render): su disco es efímero, así que sin esto
# los archivos subidos se pierden en cada redeploy/reinicio del contenedor.
# Proveedor usado en este proyecto: Supabase Storage, no Cloudflare R2 —
# R2 exige cargar una tarjeta antes de dar acceso a la API, aunque el uso
# real se mantenga en el tier gratuito, y eso no era aceptable acá. El
# protocolo es el mismo (S3), así que cualquier proveedor S3-compatible
# sirve con estas mismas 5 variables.
# S3_ENDPOINT_URL: la URL de conexión S3 que da el proveedor (en Supabase:
#   Project Settings → Storage → S3 Connection).
# S3_BUCKET: el nombre del bucket creado en el dashboard del proveedor.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: credenciales de un token con
#   permiso de lectura/escritura sobre ese bucket únicamente.
# S3_REGION: algunos proveedores (Supabase) la piden para firmar las
#   peticiones; R2 no la necesita.
#S3_ENDPOINT_URL=
#S3_BUCKET=suiteencript-vault
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=

# Nivel de los logs estructurados (JSON a stdout, ver app/utils/logging_config.py).
# Default INFO si se omite; DEBUG es mucho más verboso (un log por
# request ya está en INFO, no hace falta subir a DEBUG salvo que estés
# depurando algo puntual).
#LOG_LEVEL=INFO

# Sentry (monitoreo de errores) — completamente opcional. Si se omite,
# la app funciona exactamente igual, solo sin reportar errores a un servicio
# externo. Crear un proyecto Flask gratis en https://sentry.io y pegar el DSN
# que te da ahí (Settings del proyecto → Client Keys (DSN)).
#SENTRY_DSN=

# Envío de correo (recuperación de contraseña) vía la API HTTP de Brevo —
# opcional: si se omiten, en desarrollo local el enlace de recuperación se
# loguea en vez de enviarse (para poder probar el flujo sin configurar
# nada); en producción, el correo simplemente no sale y queda como error
# en los logs. Se usa una API HTTP (no SMTP) porque Render bloquea la
# salida a los puertos SMTP (25/465/587) en el plan gratuito.
# BREVO_API_KEY: se genera en app.brevo.com → Settings → SMTP & API →
#   API Keys (cuenta gratuita, sin tarjeta).
# BREVO_SENDER_EMAIL: la casilla que va a figurar como remitente — hay que
#   verificarla primero en Brevo (Settings → Senders, código de 6 dígitos
#   enviado a esa casilla). No hace falta un dominio propio.
#BREVO_API_KEY=
#BREVO_SENDER_EMAIL=
